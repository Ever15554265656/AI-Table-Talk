# ---------------------------------------------------------------- AI Panel Studio 环境变量样例
# 复制为 .env 后按需修改；.env 不会被提交（含真实密钥）。
# 说明：密钥只在后端读取，永远不会下发到浏览器（PRD R8 / C-01）。

# --- 应用 ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# 前端 dev server 地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 数据库（SQLite）---
# 留空则使用 <项目根>/data/app.db
DATABASE_URL=
SQL_ECHO=false

# --- 大模型（DeepSeek / OpenAI 兼容端点）---
# 留空即自动进入 Mock 模式：仍可启动、演示与跑测试
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=45

# --- 运行模式 ---
# true = 强制使用内置 Mock Provider（不发起真实网络请求）
MOCK_MODE=true
# Mock 每条内容的模拟耗时（毫秒），测试时可设为 0
MOCK_LATENCY_MS=180

# --- 讨论节奏 ---
# 单场讨论最大轮次（6~40）
MAX_ROUNDS=20
# 每新增 N 条可见发言触发一次共识/分歧提炼
INSIGHT_EVERY_N_MESSAGES=3
# 相邻两条发言的间隔秒数
SPEAK_INTERVAL_SECONDS=1.4
# 共识/分歧条目上限
MAX_CONSENSUS_ITEMS=10
